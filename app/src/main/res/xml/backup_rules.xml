<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup is disabled in the manifest (android:allowBackup="false") because
  the Room database stores agent endpoints and masked credentials.
  These rules apply if backup is turned back on for API 30 and below.
-->
<full-backup-content>
    <exclude domain="database" path="agentos_db" />
    <exclude domain="database" path="agentos_db-shm" />
    <exclude domain="database" path="agentos_db-wal" />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
