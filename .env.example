# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: The secrets plugin ignores GEMINI_API_KEY. A release bundle
# does not contain this key unless you set INCLUDE_GEMINI_KEY_IN_RELEASE=true
# and provide a real key via the GEMINI_API_KEY environment variable or .env.
# The placeholder value below is never packaged.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
